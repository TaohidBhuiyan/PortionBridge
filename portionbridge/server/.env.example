# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Comma-separated list of any ADDITIONAL allowed CORS origins beyond
# CLIENT_URL (e.g. a staging domain). Optional — leave blank if CLIENT_URL
# is the only frontend origin. Used by both Express (app.js) and Socket.IO
# (server.js) — see config/cors.js.
ALLOWED_ORIGINS=

# Controls how Express interprets X-Forwarded-* headers (req.ip, used for
# rate limiting and audit logs). Leave unset/blank if this server is
# directly internet-facing (no reverse proxy) — that's the safe default.
# If deployed behind a reverse proxy/load balancer (Nginx, an AWS ELB,
# etc.), set this to the exact number of proxy hops in front of this
# server, e.g. 1 for a single hop. See
# https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=

# MySQL (XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portionbridge
DB_PORT=3306

# Access token — short-lived, sent in the JSON response body and used as
# "Authorization: Bearer <token>" on subsequent requests. Never stored in a cookie.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token — long-lived, stored in httpOnly cookie, used to obtain new access tokens.
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Google OAuth
# Create a Google OAuth client ID in Google Cloud Console and enable the OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Configuration (SMTP)
# Required in production for email delivery. Optional in development (emails logged to console).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@portionbridge.com
EMAIL_FROM_NAME=PortionBridge
SUPPORT_URL=https://portionbridge.com/support
