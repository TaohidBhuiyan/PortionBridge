# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Comma-separated list of any ADDITIONAL allowed CORS origins beyond
# CLIENT_URL (e.g. a staging domain). Optional — leave blank if CLIENT_URL
# is the only frontend origin. Used by both Express (app.js) and Socket.IO
# (server.js) — see config/cors.js.
ALLOWED_ORIGINS=

# Controls how Express interprets X-Forwarded-* headers (req.ip, used for
# rate limiting and audit logs). Leave unset/blank if this server is
# directly internet-facing (no reverse proxy) — that's the safe default.
# If deployed behind a reverse proxy/load balancer (Nginx, an AWS ELB,
# etc.), set this to the exact number of proxy hops in front of this
# server, e.g. 1 for a single hop. See
# https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=

# MySQL (XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portionbridge
DB_PORT=3306

# Access token — short-lived, sent in the JSON response body and used as
# "Authorization: Bearer <token>" on subsequent requests. Never stored in a cookie.
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token — long-lived, stored in httpOnly cookie, used to obtain new access tokens.
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Google OAuth
# Create a Google OAuth client ID in Google Cloud Console and enable the OAuth client.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Configuration (Brevo)
# Required in production for email delivery. Optional in development (emails logged to console).
# Get your API key from https://app.brevo.com/apikeys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@portionbridge.com
BREVO_SENDER_NAME=PortionBridge
SUPPORT_URL=https://portionbridge.com/support

# --- Disaster relief ---
# true (default): a volunteer's delivery report stays "pending verification" and only an
# administrator's verification counts it as delivered. false: reports are applied immediately.
RELIEF_REQUIRE_DELIVERY_VERIFICATION=true

# --- Disaster alerts (Phase 4) — all optional ---
# Automatic LOCAL alert when an admin verifies an incident (or raises its severity) whose stored
# severity is at or above this level: low | moderate | high | critical | off   (default: high)
ALERT_AUTO_LOCAL_MIN_SEVERITY=high
# How often the in-process sweeper retries pending/stuck/failed alert deliveries (ms; 0 disables). Default 60000
ALERT_SWEEP_INTERVAL_MS=60000
# Automatic delivery attempts per alert event before it waits for an admin "Retry delivery". Default 5
ALERT_MAX_ATTEMPTS=5

# --- Admin disaster operations (Phase 5) — optional ---
# A volunteer task with no status change for this many hours (or an unassigned pledge older than this) counts as "delayed". Default 24
RELIEF_TASK_DELAY_HOURS=24
# Seconds after which a crashed alert-delivery claim may be re-claimed. Default 300
ALERT_STALE_CLAIM_SECONDS=300
